      "oneOf": [
        {
          "description": "Спецификации задачи расширения.",
          "type": "object",
          "required": [ "invoke" ],
          "propertyNames": { "enum": [ "invoke" ] },
          "properties": {
            "invoke": {
              "description": "Идентификатор функции обратного вызова задачи из программного расширения MLS-модели.",
              "type": "string"
            }
          }
        },
        {
          "description": "Спецификации задачи агрегирования.",
          "type": "object",
