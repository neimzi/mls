{
  "$mls_version": "2.1.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Спецификации MLS-модели. Управляют инициализацией объекта.",
  "type": "object",
  "required": [ 
    "output_interval",
    "randomizer_seed",
    "threads_amount",
    "time_increment",
    "layers",
    "on_construction",
    "on_evolution",
    "on_destruction"
  ],
  "properties": {
    "output_interval": {
      "description": "Интервал времени симуляции между последовательными выводами модели.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "randomizer_seed": {
      "description": "Порождающий элемент последовательности псевдослучайных чисел, назначаемый моделью.",
      "type": "integer",
      "minimum": 0
    },
    "threads_amount": {
      "description": "Количество потоков OpenMP для выполнения задач с распараллеленными циклами, назначаемое моделью.",
      "type": "integer",
      "minimum": 1
    },
    "time_increment": {
      "description": "Инкремент времени симуляции за шаг эволюции модели.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "layers": {
      "type": "object",
      "description": "Ассоциативный список слоев модели. Для каждой записи ключ представляет собой задаваемый идентификатор слоя, а значение - его спецификации.",
      "patternProperties": {
        "": {
          "description": "Спецификации слоя.",
          "required": [
            "elements_amount",
            "parameters",
            "variables"
          ],
          "properties": {
            "elements_amount": {
              "description": "Количество элементов слоя.",
              "type": "integer",
              "minimum": 0
            },
            "parameters": {
              "description": "Ассоциативный список параметров слоя. Для каждой записи ключ представляет собой выбираемый идентификатор параметра, а значение - данные для его инициализации. Отдельно взятый параметр, в отличие от переменной, является общим для элементов слоя.",
              "$ref": "#/definitions/variables"
            },
            "variables": {
              "description": "Ассоциативный список переменных слоя. Для каждой записи ключ представляет собой выбираемый идентификатор переменной, а значение - данные для ее инициализации. Отдельно взятая переменная, в отличие от параметра, является индивидуальной для элемента слоя.",
              "$ref": "#/definitions/variables"
            },
            "frame": {
              "description": "Идентификатор типа системы отсчета, ассоциируемого со слоем в подходящих задачах модели.",
              "enum": [ "global", "local" ]
            },
            "lattice": {
              "description": "Идентификатор типа кристаллической решетки, ассоциируемого со слоем в подходящих задачах модели.",
              "enum": [ "fcc" ]
            },
            "symmetry": {
              "description": "Идентификатор типа симметрии, ассоциируемого со слоем в подходящих задачах модели.",
              "enum": [ "cubic" ]
            }
          }
        }
      }
    },
    "on_construction": {
      "type": "array",
      "description": "Список задач, выполняемых при создании объекта модели. Каждая запись представляет собой спецификации выбираемого класса задачи.",
      "items": { "$ref": "#/definitions/tasks" }
    },
    "on_evolution": {
      "type": "array",
      "description": "Список задач, выполняемых за шаг эволюции объекта модели. Каждая запись представляет собой спецификации выбираемого класса задачи.",
      "items": { "$ref": "#/definitions/tasks" }
    },
    "on_destruction": {
      "type": "array",
      "description": "Список задач, выполняемых при уничтожении объекта модели. Каждая запись представляет собой спецификации выбираемого класса задачи.",
      "items": { "$ref": "#/definitions/tasks" }
    }
  },
