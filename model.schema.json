            },
            "method": {
              "description": "Идентификатор метода агрегирования.",
              "enum": [ "mean", "mean_oriented", "mean_oriented_volumed", "mean_volumed" ]
            },
            "target": {
              "description": "Идентификатор целевого слоя агрегирования. Конкретизирует элементы, получающие значения переменной.",
              "type": "string"
